# Șablon de configurare pentru backend-ul Mentor AI.
# Copiază acest fișier în `backend/.env` și completează valorile pe care le ai:
#
#   cp backend/.env.example backend/.env
#
# IMPORTANT: `.env` este exclus din git (vezi .gitignore). Nu comite niciodată
# chei reale și nu le trimite pe chat sau email.
#
# Toate cheile de AI sunt opționale. Fiecare provider fără cheie cade automat
# pe răspunsuri mock (vezi backend/src/providers/*.js), deci aplicația pornește
# și fără nicio cheie configurată - util în development, dar răspunsurile NU
# sunt generate de un model real.

# Portul pe care ascultă serverul Express.
# În producție (CloudLinux / Passenger) portul este atribuit automat prin
# variabila PORT, deci lasă valoarea necompletată acolo.
PORT=3001

# Setează pe "production" pe hosting. Controlează flag-ul `secure` al
# cookie-ului de sesiune, care altfel nu ar circula peste HTTPS.
NODE_ENV=production

# --- Persistență ---
# Unde se salvează datele aplicației (conturi, monede, calendar, conversații).
# Implicit: folderul `data/` din rădăcina aplicației.
# Lasă necompletat dacă nu ai un motiv anume; folderul este exclus din git și
# din sincronizarea prin FTP, deci nu este suprascris la deploy.
DATA_DIR=

# STORE=json este implicit și rămâne așa în producție până treci conștient
# pe MySQL. Nu pune mysql doar pentru că variabilele de mai jos există.
# STORE=mysql cere MYSQL_URL sau MYSQL_HOST + MYSQL_USER + MYSQL_DATABASE.
# Parola nu se comite. Pașii DirectAdmin sunt în DEPLOY.md.
STORE=
MYSQL_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Secunde de așteptare pentru lacătul de scriere. Implicit 15.
# MYSQL_LOCK_WAIT_SECONDS=

# Sentry este oprit fără DSN. Nu pune DSN-ul până actualizezi furnizorii GDPR.
# VITE_SENTRY_DSN trebuie să fie prezent la build-ul din GitHub (mediul
# mentor.ai), altfel nu intră în pachetul frontend. SENTRY_DSN stă pe server,
# ca backend-ul și CSP-ul să accepte aceeași gazdă.
# Eșantion implicit 0.25. Urmele de performanță stau pe 0.
SENTRY_DSN=
SENTRY_SAMPLE_RATE=
SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_DSN=
VITE_SENTRY_SAMPLE_RATE=

# Primește alerte, fără spam: prima eroare de un tip într-o oră, încă una
# dacă se repetă (8 apariții), maxim 10 pe zi. Inclusiv cădere Node,
# salvare eșuată, port, copie zilnică eșuată, copie mai veche de 26 de ore
# și SMTP eșuat de 3 ori. Contorul supraviețuiește restartului
# (logs/alert-state.json), ca o buclă de căderi să nu umple inboxul.
# Mailul pleacă doar dacă sunt setate și SMTP_HOST + SMTP_FROM.
# Fără adresă, erorile rămân doar în logs/errors.log.
ADMIN_EMAIL=

# Cheie pentru copiile rapide bak1–bak3. Cifrarea nu stă pe scrierea
# principală: rulează după salvare, cel mult o dată la 15 minute.
# Minim 16 caractere, alt șir decât parolele. Fără ea, bak1–bak3 rămân în clar.
BACKUP_KEY=

# Cheia publică RSA pentru copia zilnică. Cheia privată nu stă pe server.
# O generezi pe laptop cu `node scripts/backup-keygen.mjs`.
# Poți lipi PEM-ul aici sau îl urci doar ca backend/backup-public.pem.
# Procesul scrie singur copia zilei (ora României), în afara cererilor.
# Pe DirectAdmin poți adăuga și cronul din DEPLOY.md (03:30).
BACKUP_PUBLIC_KEY=

# --- Conturi ---
# Codul de invitație pentru conturile de profesor. Rolul de profesor vede
# analitica mai multor elevi, deci nu poate fi ales liber de client.
# Dacă valoarea lipsește, înregistrarea ca profesor este BLOCATĂ complet.
TEACHER_INVITE_CODE=

# Origini extra permise pentru CORS, separate prin virgulă.
# Same-origin (frontend servit de același Express) funcționează fără listă.
# Completează doar dacă frontend-ul e pe alt domeniu decât API-ul.
# Exemplu: https://mentorai.ro,https://www.mentorai.ro
CORS_ORIGINS=

# --- Lansare publică ---
# În producție (NODE_ENV=production) site-ul e ÎNCHIS: lumea vede „În curând”.
# Când e gata de lansare, pune SITE_PUBLIC=1 în DirectAdmin și repornește Node.
# SITE_CLOSED=1 închide site-ul și local / în teste.
SITE_PUBLIC=
SITE_CLOSED=

# Parolă ca tu să poți intra pe aplicație cât e închisă.
# Dacă lipsește, nimeni nu intră (nici o parolă scrisă în cod).
# Se trimite doar din formularul „Intrare creator”, prin POST, nu în adresă.
# După SITE_PUBLIC=1, același formular (la /creator) emite cookie-ul de moderare.
# PREVIEW_COOKIE_SECRET semnează cookie-ul. Pune un șir lung, altul decât parola.
# Datele operatorului, afișate pe /confidentialitate și /termeni.
# Fără nume și email, `npm run prelansare` iese cu eroare.
# LEGAL_OPERATOR_ADDRESS este opțională. Dacă lipsește, paginile nu arată adresa.
# Nu pune un CIF sau o adresă inventată. LEGAL_CUI rămâne gol pentru
# o persoană fizică. LEGAL_DPO rămâne gol dacă nu există responsabil.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT=
LEGAL_CUI=
LEGAL_DPO=
# Ieșire: /creator/iesire
PREVIEW_PASSWORD=
# Cel puțin 32 de caractere. Semnează cookie-ul de previzualizare.
PREVIEW_COOKIE_SECRET=
# Cel puțin 32 de caractere. Obligatoriu în producție, alt șir decât parola.
SESSION_SECRET=
# Cel puțin 32 de caractere. Deschide detaliile din /api/health (email, backup).
HEALTH_TOKEN=

# --- Protecție temporară extra (opțională, HTTP Basic) ---
# Implicit OPRITĂ. Se reactivează doar cu ENABLE_STAGING_AUTH=1.
ENABLE_STAGING_AUTH=
STAGING_AUTH_USER=
STAGING_AUTH_PASSWORD=

# --- Recenzie foto (opțional) ---
# Tutorele răspunde din lecțiile salvate. Un model plătit pentru tutore
# pornește doar când TUTOR_LLM=1 și OPENAI_KEY este completată. Altfel
# chatul nu face nicio cerere către OpenAI.
# TUTOR_LLM_MODEL, dacă rămâne gol, este gpt-4o-mini. E modelul ieftin.
# Recenzia foto rămâne pe OPENAI_MODEL (implicit gpt-4o), care costă de
# câteva ori mai mult, și nu e folosită de tutore.
# TUTOR_LLM_MAX_TOKENS, dacă rămâne gol, este 400, cu plafon 800.
# Se apelează o singură completare, și doar când potrivirea locală nu e
# sigură, în limita de 10 mesaje pe minut și 60 pe oră. Prețul zilei e
# pe lista OpenAI, nu e scris în aplicație.
# Fără chei, recenzia foto nu apelează un serviciu plătit.
TUTOR_LLM=
TUTOR_LLM_MODEL=
TUTOR_LLM_MAX_TOKENS=
PROVIDER_TIMEOUT_MS=8000
MAX_TOKENS=2048
OPENAI_KEY=
OPENAI_MODEL=gpt-4o
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# --- URL public ---
# Obligatoriu în producție pentru linkurile din email (acord, parolă,
# magic link de părinte). Exemplu: https://suntde10.ro
# Fără un URL https valid, procesul nu pornește când NODE_ENV=production.
# În development, dacă lipsește, se folosește localhost.
APP_BASE_URL=

# --- Evaluare Națională (timpi de sală) ---
# Implicit: 60 minute predare anticipată, 120 minute lucrare (metodologia EN).
# În teste se scurtează prin EN_MIN_STAY_MS / EN_EXAM_MS.
# EN_MIN_STAY_MS=3600000
# EN_EXAM_MS=7200000

# --- Email (SMTP) ---
# Fără SMTP_HOST + SMTP_FROM, mesajele rămân doar în inbox-ul din aplicație.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

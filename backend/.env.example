# Șablon de configurare pentru backend-ul Mentor AI.
# Copiază acest fișier în `backend/.env` și completează valorile pe care le ai:
#
#   cp backend/.env.example backend/.env
#
# IMPORTANT: `.env` este exclus din git (vezi .gitignore). Nu comite niciodată
# chei reale și nu le trimite pe chat sau email.
#
# Toate cheile de AI sunt opționale. Fiecare provider fără cheie cade automat
# pe răspunsuri mock (vezi backend/src/providers/*.js), deci aplicația pornește
# și fără nicio cheie configurată - util în development, dar răspunsurile NU
# sunt generate de un model real.

# Portul pe care ascultă serverul Express.
# În producție (CloudLinux / Passenger) portul este atribuit automat prin
# variabila PORT, deci lasă valoarea necompletată acolo.
PORT=3001

# --- Protecție temporară a site-ului (staging) ---
# Cât timp aplicația nu are autentificare reală (vezi plan-imbunatatiri.md,
# Faza 1), orice vizitator poate citi datele oricărui cont. Setează ambele
# valori în producție ca să ceri user/parolă la nivel de site.
# Dacă una dintre ele lipsește, protecția este DEZACTIVATĂ.
STAGING_AUTH_USER=
STAGING_AUTH_PASSWORD=

# --- Motoare de chat AI ---
# Ordinea de fallback diferă pe plan (vezi backend/src/routes/chat.js):
#   free    -> GPT-4o -> Wolfram -> Mathpix -> Gemini -> Claude
#   pro     -> Gemini -> Claude -> Wolfram
#   premium -> consiliu (GPT-4o + Wolfram + Gemini + Mathpix), Claude judecător

# Anthropic (https://console.anthropic.com/settings/keys)
CLAUDE_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Unelte specializate ---

# Wolfram|Alpha, pentru calcule matematice și științifice
# (https://developer.wolframalpha.com/access)
WOLFRAM_KEY=

# Mathpix OCR, pentru recunoaștere de text și formule din poze
# (https://console.mathpix.com/)
#
# ATENȚIE: Mathpix are nevoie de AMBELE valori. Dacă setezi doar una,
# providerul cade silențios pe mock (backend/src/providers/mathpix.js
# verifică `!APP_ID || !APP_KEY`), fără niciun mesaj de eroare.
# Setează-le pe amândouă sau pe niciuna.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Șablon de configurare pentru backend-ul Mentor AI.
# Copiază acest fișier în `backend/.env` și completează valorile pe care le ai:
#
#   cp backend/.env.example backend/.env
#
# IMPORTANT: `.env` este exclus din git (vezi .gitignore). Nu comite niciodată
# chei reale și nu le trimite pe chat sau email.
#
# Toate cheile de AI sunt opționale. Fiecare provider fără cheie cade automat
# pe răspunsuri mock (vezi backend/src/providers/*.js), deci aplicația pornește
# și fără nicio cheie configurată - util în development, dar răspunsurile NU
# sunt generate de un model real.

# Portul pe care ascultă serverul Express.
# În producție (CloudLinux / Passenger) portul este atribuit automat prin
# variabila PORT, deci lasă valoarea necompletată acolo.
PORT=3001

# Setează pe "production" pe hosting. Controlează flag-ul `secure` al
# cookie-ului de sesiune, care altfel nu ar circula peste HTTPS.
NODE_ENV=production

# --- Persistență ---
# Unde se salvează datele aplicației (conturi, monede, calendar, conversații).
# Implicit: folderul `data/` din rădăcina aplicației.
# Lasă necompletat dacă nu ai un motiv anume; folderul este exclus din git și
# din sincronizarea prin FTP, deci nu este suprascris la deploy.
DATA_DIR=

# --- Conturi ---
# Codul de invitație pentru conturile de profesor. Rolul de profesor vede
# analitica mai multor elevi, deci nu poate fi ales liber de client.
# Dacă valoarea lipsește, înregistrarea ca profesor este BLOCATĂ complet.
TEACHER_INVITE_CODE=

# Origini extra permise pentru CORS, separate prin virgulă.
# Same-origin (frontend servit de același Express) funcționează fără listă.
# Completează doar dacă frontend-ul e pe alt domeniu decât API-ul.
# Exemplu: https://mentorai.ro,https://www.mentorai.ro
CORS_ORIGINS=

# --- Lansare publică ---
# În producție (NODE_ENV=production) site-ul e ÎNCHIS: lumea vede „În curând”.
# Când e gata de lansare, pune SITE_PUBLIC=1 în DirectAdmin și repornește Node.
# SITE_CLOSED=1 închide site-ul și local / în teste.
SITE_PUBLIC=
SITE_CLOSED=

# Parolă ca tu să poți intra pe aplicație cât e închisă.
# Dacă lipsește, nimeni nu intră (nici o parolă scrisă în cod).
# Se trimite doar din formularul „Intrare creator”, prin POST, nu în adresă.
# PREVIEW_COOKIE_SECRET semnează cookie-ul. Pune un șir lung, altul decât parola.
# Ieșire: /creator/iesire
PREVIEW_PASSWORD=
PREVIEW_COOKIE_SECRET=

# --- Protecție temporară extra (opțională, HTTP Basic) ---
# Implicit OPRITĂ. Se reactivează doar cu ENABLE_STAGING_AUTH=1.
ENABLE_STAGING_AUTH=
STAGING_AUTH_USER=
STAGING_AUTH_PASSWORD=

# --- Motoare de chat AI ---
# Timeout per apel de provider, în milisecunde. Dacă un motor nu răspunde,
# lanțul de fallback trece la următorul în loc să rămână agățat.
PROVIDER_TIMEOUT_MS=8000

# Lungimea maximă a răspunsului generat (Claude, OpenAI, Gemini).
MAX_TOKENS=2048
# Ordinea de fallback diferă pe plan (vezi backend/src/routes/chat.js):
#   free    -> GPT-4o -> Wolfram -> Mathpix -> Gemini -> Claude
#   pro     -> Gemini -> Claude -> Wolfram
#   premium -> consiliu (GPT-4o + Wolfram + Gemini + Mathpix), Claude judecător

# Anthropic (https://console.anthropic.com/settings/keys)
CLAUDE_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Unelte specializate ---

# Wolfram|Alpha, pentru calcule matematice și științifice
# (https://developer.wolframalpha.com/access)
WOLFRAM_KEY=

# Mathpix OCR, pentru recunoaștere de text și formule din poze
# (https://console.mathpix.com/)
#
# ATENȚIE: Mathpix are nevoie de AMBELE valori. Dacă setezi doar una,
# providerul cade silențios pe mock (backend/src/providers/mathpix.js
# verifică `!APP_ID || !APP_KEY`), fără niciun mesaj de eroare.
# Setează-le pe amândouă sau pe niciuna.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# --- URL public ---
# Folosit pentru redirecturile Stripe Checkout și OAuth Google/Notion.
# Exemplu producție: https://mentorai.ro
# Local cu Vite: http://localhost:5173 (callback-ul /api e proxiat către 3001).
# Dacă lipsește, serverul reconstruiește originea din request.
APP_BASE_URL=

# --- Plăți (Faza 6) ---
# Fără STRIPE_SECRET_KEY, checkout-ul rămâne mock etichetat (`mocked: true`).
# Netopia poate înlocui Stripe mai târziu; fluxul de activare e același.
STRIPE_SECRET_KEY=
# Secretul endpoint-ului de webhook (POST /api/subscriptions/webhook).
# Obligătoriu pentru activarea planului după plata Stripe.
STRIPE_WEBHOOK_SECRET=

# --- Calendar OAuth ---
# Fără aceste perechi, POST /api/calendar/connect rămâne mock etichetat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Secret pentru semnarea parametrului `state` (CSRF). Dacă lipsește, se
# generează la pornirea procesului (fluxurile OAuth în curs expiră la restart).
OAUTH_STATE_SECRET=

# --- Evaluare Națională (timpi de sală) ---
# Implicit: 60 minute predare anticipată, 120 minute lucrare (metodologia EN).
# În teste se scurtează prin EN_MIN_STAY_MS / EN_EXAM_MS.
# EN_MIN_STAY_MS=3600000
# EN_EXAM_MS=7200000

# --- Email (SMTP) ---
# Fără SMTP_HOST + SMTP_FROM, mesajele rămân doar în inbox-ul din aplicație.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (Twilio) ---
# Fără aceste trei, codul de acces părinte rămâne doar în inbox (`mocked: true`).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

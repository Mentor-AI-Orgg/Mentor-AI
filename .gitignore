# Dependințe
node_modules/

# Variabile de mediu (conțin cheile API - NU se comit niciodată)
.env
.env.*
!.env.example

# Loguri
logs/
*.log

# Rapoarte locale (pot conține fragmente din lecții sau din manuale)
reports/
npm-debug.log*

# Cache / build
.cache/
dist/
build/
coverage/

# Semnal de restart pentru Passenger (generat la fiecare deploy)
tmp/

# Datele aplicației (conturi, monede, calendar). Rămân doar pe server.
# Slash-ul de la început ancorează regula la rădăcina repo-ului: fără el,
# regula ar exclude și `backend/src/data/`, adică tot codul store-urilor.
/data/

# Stare de sincronizare lăsată pe server de acțiunea de deploy FTP
.ftp-deploy-sync-state.json

# Fișiere de sistem / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

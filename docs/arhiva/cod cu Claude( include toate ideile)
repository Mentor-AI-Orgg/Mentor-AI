function startTest() {
  currentTest = [...TEST_QUESTIONS].sort(() => Math.random() - 0.5);
  testScore = 0;
  testAnswers = [];
  renderTests(document.getElementById('mainContent'));
}

function renderCurrentQuestion() {
  if (testAnswers.length >= currentTest.length) {
    const percentage = Math.round((testScore / currentTest.length) * 100);
    const passed = percentage >= 90;

    // Update mission
    const mission = currentUser.dailyMissions.find(m => m.id === 'test_90_percent');
    if (mission && passed) mission.progress = 100;

    currentUser.testsCompleted++;
    currentUser.correctAnswers += testScore;

    // Check achievements
    if (currentUser.testsCompleted >= 100 && !currentUser.achievements.includes('test_master')) {
      currentUser.achievements.push('test_master');
      showAchievement('🧠 Test Master', 'Completeaza 100 de teste');
    }
    if (currentUser.correctAnswers >= 100 && !currentUser.achievements.includes('accuracy')) {
      currentUser.achievements.push('accuracy');
      showAchievement('🎯 Accuracy Expert', '100 raspunsuri corecte');
    }

    notifyParent('Test', `Alex a completat un test: ${percentage}%`);

    return `
      <div class="text-center">
        <div style="font-size: 4rem;">${percentage >= 90 ? '🎉' : percentage >= 70 ? '👍' : '💪'}</div>
        <h2>Test Finalizat!</h2>
        <p style="font-size: 2rem; color: ${percentage >= 90 ? 'var(--success)' : percentage >= 70 ? 'var(--accent)' : 'var(--danger)'};">${percentage}%</p>
        <p class="text-muted">${testScore} / ${currentTest.length} raspunsuri corecte</p>
        <p class="text-muted">+${testScore * 10} XP castigat</p>
        <button class="btn btn-primary" onclick="currentTest=null; testScore=0; testAnswers=[]; renderTests(document.getElementById('mainContent'));">Inchide</button>
      </div>
    `;
  }

  const q = currentTest[testAnswers.length];
  return `
    <div class="test-question">
      <h4>${q.question}</h4>
      <div class="test-options">
        ${q.options.map((opt, i) => `
          <div class="test-option" onclick="answerQuestion(${i})">${opt}</div>
        `).join('')}
      </div>
    </div>
  `;
}

function answerQuestion(answerIndex) {
  const q = currentTest[testAnswers.length];
  const isCorrect = answerIndex === q.correct;
  if (isCorrect) testScore++;

  testAnswers.push({ question: q.id, correct: isCorrect });

  // Update correct answers mission
  const mission = currentUser.dailyMissions.find(m => m.id === 'correct_answers');
  if (mission && isCorrect) mission.progress = Math.min(mission.progress + 1, mission.target);

  addXp(isCorrect ? 10 : 5, isCorrect ? 10 : 0);

  const testArea = document.getElementById('testArea');
  if (testArea) {
    testArea.innerHTML = `
      <div class="card-header"><div class="card-title">📝 Test in desfasurare</div><span>Intrebare ${testAnswers.length} / 4</span></div>
      ${renderCurrentQuestion()}
    `;
  }
}


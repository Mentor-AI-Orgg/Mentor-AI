// --- REAL AI ENGINE (Claude) ---
let isAiResponding = false;

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function buildSystemPrompt() {
  const p = AI_PERSONALITIES.find(x => x.id === selectedPersonality);
  const grade = currentUser?.class || '5';
  return `Esti ${p.name}, un tutore AI pentru elevi din Romania, in aplicatia educationala MENTOR. Stilul tau de personalitate este "${p.style}": ${p.desc}.

CONTEXT ELEV:
- Elevul este in clasa a ${grade}-a, conform sistemului de invatamant din Romania.
- Materiile relevante includ (in functie de clasa): Matematica, Limba si literatura romana, Fizica, Chimie, Biologie, Istorie, Geografie, Informatica etc., conform curriculumului national romanesc (programa scolara oficiala).

REGULI STRICTE DE PREDARE (metoda socratica):
1. NU oferi niciodata raspunsul final la un exercitiu sau problema in mod direct, chiar daca elevul insista. In schimb, pune intrebari ghidate, ofera indicii treptate si ajuta-l sa ajunga singur la raspuns.
2. Daca elevul da un raspuns corect, confirma-l si intreaba-l cum a ajuns acolo sau cum ar aplica ideea intr-un exercitiu similar.
3. Daca elevul da un raspuns gresit, nu spune direct "gresit" fara context - ghideaza-l inapoi la pasul unde a gresit, cu o intrebare.
4. Foloseste terminologia, notatiile si exemplele specifice scolii romanesti (ex: "regula de trei simpla", "cazuri de factor comun", subiecte din manualele romanesti).
5. Adapteaza complexitatea limbajului strict la nivelul clasei a ${grade}-a - nici prea simplu, nici prea avansat.
6. Raspunde EXCLUSIV in limba romana, cu diacritice corecte, intr-un ton potrivit personalitatii tale.
7. Tine raspunsurile scurte si clare (2-5 propozitii), folosind eventual liste sau formule matematice simple in text (ex: a^2 + b^2 = c^2), fara markdown complex.
8. Daca intrebarea elevului nu are legatura cu scoala, redirectioneaza-l politicos catre teme scolare, ramanand in personajul tau.
9. Incurajeaza-l constant si lauda efortul, nu doar rezultatul corect.`;
}

async function callMentorAI(apiMessages, systemPrompt) {
  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-6",
      max_tokens: 1000,
      system: systemPrompt,
      messages: apiMessages
    })
  });
  if (!response.ok) throw new Error('Eroare API: ' + response.status);
  const data = await response.json();
  const text = (data.content || [])
    .map(block => block.type === 'text' ? block.text : '')
    .join('\n')
    .trim();
  return text || 'Hmm, nu am reusit sa formulez un raspuns. Poti reformula intrebarea?';
}

function setChatInputDisabled(disabled) {
  const input = document.getElementById('chatInput');
  const area = document.querySelector('.chat-input-area');
  if (input) input.disabled = disabled;
  if (area) area.querySelectorAll('button').forEach(b => b.disabled = disabled);
}

async function sendChat() {
  if (isAiResponding) return;
  const input = document.getElementById('chatInput');
  const text = input.value.trim();
  if (!text) return;

  chatHistory.push({ type: 'user', text });
  input.value = '';
  renderChatMessages();

  await requestAiTurn(chatHistory.filter(m => !m.pending).map(m => ({
    role: m.type === 'ai' ? 'assistant' : 'user',
    content: m.text
  })));

  notifyParent('AI Tutor', `Alex a avut o sesiune cu Mentor AI`);
}

async function requestAiTurn(apiMessages) {
  isAiResponding = true;
  setChatInputDisabled(true);
  chatHistory.push({ type: 'ai', text: '', pending: true });
  renderChatMessages();

  try {
    const systemPrompt = buildSystemPrompt();
    const reply = await callMentorAI(apiMessages, systemPrompt);
    chatHistory = chatHistory.filter(m => !m.pending);
    chatHistory.push({ type: 'ai', text: reply });
  } catch (err) {
    chatHistory = chatHistory.filter(m => !m.pending);
    chatHistory.push({ type: 'ai', text: 'Ne pare rau, am intampinat o problema de conexiune cu AI-ul. Mai incearca o data in cateva momente. 🙏' });
  }

  isAiResponding = false;
  setChatInputDisabled(false);
  renderChatMessages();
  input_focus_safe();
}

function input_focus_safe() {
  const input = document.getElementById('chatInput');
  if (input) input.focus();
}

function renderChatMessages() {
  const container = document.getElementById('chatMessages');
  if (!container) return;
  container.innerHTML = chatHistory.map(msg => {
    if (msg.pending) {
      return `<div class="chat-message ai"><div class="typing-indicator"><span></span><span></span><span></span></div></div>`;
    }
    return `
    <div class="chat-message ${msg.type}">
      <strong>${msg.type === 'ai' ? AI_PERSONALITIES.find(p => p.id === selectedPersonality).name + ':' : 'Tu:'}</strong><br>
      ${escapeHtml(msg.text).replace(/\n/g, '<br>')}
    </div>
  `;
  }).join('');
  container.scrollTop = container.scrollHeight;
}

function startVoice() {
  if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognition = new SpeechRecognition();
    recognition.lang = 'ro-RO';
    recognition.onresult = (e) => {
      const transcript = e.results[0][0].transcript;
      document.getElementById('chatInput').value = transcript;
      sendChat();
    };
    recognition.start();
  } else {
    alert('Voice recognition not supported in this browser.');
  }
}

async function explainMode(mode) {
  if (isAiResponding) return;

  const modeLabels = {
    simple: 'foarte simpla, pe intelesul unui copil mic, cu un exemplu jucaus',
    visual: 'vizuala, folosind o descriere imagistica sau o comparatie usor de imaginat',
    academic: 'academica si precisa, cu definitie clara si termenii corecti',
    real: 'printr-un exemplu concret din viata de zi cu zi',
    story: 'sub forma unei scurte povesti sau analogii de tip joc'
  };
  const modeIcon = EXPLAIN_MODES.find(m => m.id === mode)?.icon || '❓';
  const modeTitle = EXPLAIN_MODES.find(m => m.id === mode)?.title || '';

  const lastUserMsg = [...chatHistory].reverse().find(m => m.type === 'user' && !m.pending);
  const topic = lastUserMsg ? lastUserMsg.text : 'ultimul subiect discutat, sau daca nu exista niciunul, alege un concept de baza potrivit clasei elevului';

  chatHistory.push({ type: 'user', text: `${modeIcon} Explica-mi in mod "${modeTitle}"` });
  renderChatMessages();

  const userPrompt = `Explica-mi urmatorul subiect intr-un mod ${modeLabels[mode]}: "${topic}". Poti sa dai si raspunsul/rezolvarea de data asta, daca e o explicatie de concept (nu doar un indiciu), dar ramai concis.`;

  await requestAiTurn([{ role: 'user', content: userPrompt }]);
}


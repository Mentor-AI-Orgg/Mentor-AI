            <div style="font-size: 3rem; margin-bottom: 12px;">${ach.name.split(' ')[0]}</div>
            <h4>${ach.name.substring(2)}</h4>
            <p class="text-muted">${ach.desc}</p>
            <div class="progress-bar" style="margin-top: 12px;"><div class="progress-fill" style="width: ${Math.min((ach.current / ach.target) * 100, 100)}%"></div></div>
            <p class="text-muted" style="margin-top: 8px; font-size: 0.85rem;">${ach.current} / ${ach.target}</p>
            ${unlocked ? '<span class="text-success">✅ Deblocat</span>' : '<span class="text-muted">🔒 Blocat</span>'}
          </div>
        `;
      }).join('')}
    </div>
  `;
}

// --- PROFILE ---

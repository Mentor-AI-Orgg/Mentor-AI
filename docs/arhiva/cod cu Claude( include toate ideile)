function launchProjectile() {
  const ball = document.getElementById('simBall');
  const vel = parseInt(document.getElementById('velSlider').value);
  const grav = parseFloat(document.getElementById('gravSlider').value);
  const distance = (vel * vel) / grav * 2;
  ball.style.transition = 'all 1.5s ease-out';
  ball.style.left = Math.min(distance, 400) + 'px';
  ball.style.bottom = '100px';
  setTimeout(() => {
    ball.style.transition = 'all 0.5s ease-in';
    ball.style.bottom = '20px';
  }, 1500);
}


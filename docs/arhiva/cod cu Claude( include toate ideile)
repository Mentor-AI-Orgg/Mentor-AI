  const mission = currentUser.dailyMissions.find(m => m.id === missionId);
  if (!mission || mission.progress >= mission.target) return;

  mission.progress = mission.target;
  addXp(10, 10);

  // Check if all completed
  const allDone = currentUser.dailyMissions.every(m => m.progress >= m.target);
  if (allDone && !currentUser.allMissionsCompleted) {
    currentUser.allMissionsCompleted = true;
    addXp(50, 30);
    showAchievement('📅 Misiuni Complete', 'Ai terminat toate misiunile zilnice!');
    notifyParent('Misiuni', `Alex a completat TOATE misiunile zilnice! +80 XP total`);

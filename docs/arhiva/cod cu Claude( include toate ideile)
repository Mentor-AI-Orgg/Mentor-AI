// --- NAVIGATION ---
function navigate(page) {
  currentPage = page;
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  const navItems = document.querySelectorAll('.nav-item');
  const pageMap = {
    'dashboard': 0, 'ai-tutor': 1, 'learning-map': 2, 'lessons': 3,
    'tests': 4, 'scanner': 5, 'simulations': 6, 'shop': 7,
    'friends': 8, 'leaderboard': 9, 'achievements': 10, 'profile': 11, 'settings': 12
  };
  if (navItems[pageMap[page]]) navItems[pageMap[page]].classList.add('active');

  const content = document.getElementById('mainContent');
  content.innerHTML = '';

  switch(page) {
    case 'dashboard': renderDashboard(content); break;
    case 'ai-tutor': renderAITutor(content); break;
    case 'learning-map': renderLearningMap(content); break;
    case 'lessons': renderLessons(content); break;
    case 'tests': renderTests(content); break;
    case 'scanner': renderScanner(content); break;
    case 'simulations': renderSimulations(content); break;
    case 'shop': renderShop(content); break;
    case 'friends': renderFriends(content); break;
    case 'leaderboard': renderLeaderboard(content); break;
    case 'achievements': renderAchievements(content); break;
    case 'profile': renderProfile(content); break;
    case 'settings': renderSettings(content); break;
  }
}


<body>

<!-- AUTH SCREEN -->
<div id="authScreen" class="auth-container">
  <div class="auth-box animate-fade">
    <div class="text-center mb-3">
      <div style="font-size: 4rem;">📚</div>
      <h2>MENTOR APP</h2>
      <p class="text-muted">Invata inteligent, progreseaza rapid</p>
    </div>
    <div class="tabs" style="margin-bottom: 24px;">
      <div class="tab active" onclick="switchAuthTab('login', event)">Autentificare</div>
      <div class="tab" onclick="switchAuthTab('register', event)">Inregistrare</div>
    </div>
    <div id="loginForm">
      <div class="form-group">
        <label>Email</label>
        <input type="email" class="form-input" id="loginEmail" placeholder="nume@exemplu.ro" value="elev@test.ro">
      </div>
      <div class="form-group">
        <label>Parola</label>
        <input type="password" class="form-input" id="loginPassword" placeholder="••••••••" value="123456">
      </div>
      <div class="form-group">
        <label>Tip cont</label>
        <select class="form-input" id="loginType">
          <option value="student">Elev</option>
          <option value="parent">Parinte</option>
        </select>
      </div>
      <button class="btn btn-primary" style="width:100%;" onclick="doLogin()">Intra in aplicatie</button>
    </div>
    <div id="registerForm" class="hidden">
      <div class="form-group">
        <label>Username</label>

}

function toggleSetting(category, key) {
  currentUser.settings[category][key] = !currentUser.settings[category][key];
}

// --- PARENT INBOX ---
function switchParentTab(tab, evt) {
  document.querySelectorAll('#parentScreen .tab').forEach(t => t.classList.remove('active'));
  const e = evt || window.event;
  if (e && e.target) e.target.classList.add('active');
  document.getElementById('parentInbox').classList.toggle('active', tab === 'inbox');
  document.getElementById('parentSettings').classList.toggle('active', tab === 'settings');
}

function renderParentInbox() {
  const container = document.getElementById('parentNotifications');
  if (!container) return;

  // Update child stats
  document.getElementById('parentChildName').textContent = currentUser.childName || 'Alex';
  document.getElementById('parentChildLevel').textContent = 'Nivel ' + (currentUser.childLevel || 5);
  document.getElementById('parentChildStreak').textContent = (currentUser.childStreak || 12) + ' zile';

  const notifs = currentUser.notifications || [];
  if (notifs.length === 0) {
    container.innerHTML = '<p class="text-muted text-center">Nu exista notificari inca.</p>';
    return;
  }

  container.innerHTML = notifs.map(n => `
    <div class="notification-item ${n.read ? '' : 'unread'}">
      <div style="font-size: 1.5rem;">
        ${n.type === 'streak' ? '🔥' : n.type === 'level_up' ? '⭐' : n.type === 'test' ? '📝' : n.type === 'lesson' ? '📖' : n.type === 'shop' ? '🛒' : n.type === 'ai_tutor' ? '🧠' : n.type === 'exam' ? '📅' : n.type === 'friend' ? '👥' : n.type === 'achievement' ? '🏅' : '📨'}
      </div>
      <div style="flex: 1;">
        <div>${n.message}</div>
        <div class="notif-time">${n.time}</div>
      </div>
    </div>
  `).join('');
}

function renderParentSettings() {
  const container = document.getElementById('parentNotifSettings');
  if (!container) return;
  container.innerHTML = `
    <div class="notification-item" style="cursor: pointer;" onclick="setParentNotif('all')">
      <div style="flex: 1;"><strong>✅ Toate notificarile</strong><br><span class="text-muted">Primesti absolut tot ce face copilul</span></div>
      ${currentUser.notifSettings?.all ? '✅' : ''}
    </div>
    <div class="notification-item" style="cursor: pointer;" onclick="setParentNotif('important')">
      <div style="flex: 1;"><strong>⚠️ Doar importante</strong><br><span class="text-muted">Niveluri, streak pierdut, puncte slabe</span></div>
      ${currentUser.notifSettings?.important ? '✅' : ''}
    </div>
    <div class="notification-item" style="cursor: pointer;" onclick="setParentNotif('none')">
      <div style="flex: 1;"><strong>🔕 Niciuna</strong><br><span class="text-muted">Doar raport saptamanal</span></div>
      ${currentUser.notifSettings?.none ? '✅' : ''}
    </div>
  `;
}

function setParentNotif(mode) {
  currentUser.notifSettings = { all: mode === 'all', important: mode === 'important', none: mode === 'none' };
  renderParentSettings();
}

// --- XP & LEVEL SYSTEM ---
function addXp(xp, coins) {
  currentUser.xp += xp;
  currentUser.totalXp += xp;
  currentUser.coins += coins;

  // Check level up
  const nextLevel = currentUser.level + 1;
  if (nextLevel <= 20 && currentUser.xp >= XP_LEVELS[nextLevel - 1]) {
    const prevXp = XP_LEVELS[currentUser.level - 1] || 0;
    currentUser.xp -= (XP_LEVELS[nextLevel - 1] - prevXp);
    currentUser.level = nextLevel;
    currentUser.rank = RANKS[nextLevel - 1].name;
    currentUser.coins += 20;

    showLevelUp(nextLevel);
    notifyParent('Nivel', `Alex a atins Nivelul ${nextLevel}! Rang: ${RANKS[nextLevel - 1].name}`);
  }
}

function showLevelUp(level) {
  const rank = RANKS[level - 1];
  document.getElementById('levelUpText').textContent = `Ai urcat la Nivelul ${level}!`;
  document.getElementById('levelUpRewards').innerHTML = `
    <div>⭐ 50 XP Bonus</div>
    <div>🪙 20 Mentor Coins</div>
    <div style="margin-top: 8px; font-size: 1.5rem; color: ${rank.color}; animation: rainbow 3s linear infinite;">
      ${rank.emoji} ${rank.name}
    </div>
  `;
  document.getElementById('levelUpOverlay').classList.remove('hidden');

  // Confetti
  const container = document.getElementById('confettiContainer');
  container.innerHTML = '';
  const colors = ['#fbbf24', '#ef4444', '#3b82f6', '#10b981', '#8b5cf6', '#f59e0b'];
  for (let i = 0; i < 50; i++) {
    const piece = document.createElement('div');
    piece.className = 'confetti-piece';
    piece.style.left = Math.random() * 100 + 'vw';
    piece.style.background = colors[Math.floor(Math.random() * colors.length)];
    piece.style.animationDelay = Math.random() * 2 + 's';
    piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
    container.appendChild(piece);
  }
}

function closeLevelUp() {
  document.getElementById('levelUpOverlay').classList.add('hidden');
}

// --- ACHIEVEMENT POPUP ---
function showAchievement(title, desc) {
  const container = document.getElementById('achievementContainer');
  const popup = document.createElement('div');
  popup.className = 'achievement-popup';
  popup.innerHTML = `
    <div class="ach-icon">🏆</div>
    <div>
      <div class="ach-text">${title}</div>
      <div class="ach-sub">${desc}</div>
    </div>
  `;
  container.appendChild(popup);
  setTimeout(() => popup.remove(), 4000);
}

// --- PARENT NOTIFICATIONS ---
function notifyParent(type, message) {
  if (!currentUser || currentUser.type !== 'student') return;

  // In a real app, this would send to parent's backend
  // Here we just log it
  const notif = {
    id: Date.now(),
    type: type.toLowerCase().replace(/\s/g, '_'),
    message: message,
    time: 'Acum',
    read: false
  };

  if (!currentUser.parentNotifications) currentUser.parentNotifications = [];
  currentUser.parentNotifications.unshift(notif);
}

// --- MODAL ---
function showModal(html) {
  document.getElementById('modalContent').innerHTML = html;
  document.getElementById('modalOverlay').classList.add('active');
}

function closeModal(e) {
  if (e && e.target !== e.currentTarget) return;
  document.getElementById('modalOverlay').classList.remove('active');
}


function completeLesson(lessonId) {
  if (!currentUser.lessonsCompleted.includes(lessonId)) {
    currentUser.lessonsCompleted.push(lessonId);
    addXp(20, 20);
    currentUser.studyTime += 15;

    // Update mission
    const mission = currentUser.dailyMissions.find(m => m.id === 'finish_2_lessons');
    if (mission && mission.progress < mission.target) {
      mission.progress = Math.min(mission.progress + 1, mission.target);
    }

    // Check achievements
    if (currentUser.lessonsCompleted.length === 1 && !currentUser.achievements.includes('first_lesson')) {
      currentUser.achievements.push('first_lesson');
      showAchievement('🎓 Prima Lectie', 'Finalizeaza prima lectie');
    }
    if (currentUser.lessonsCompleted.length >= 100 && !currentUser.achievements.includes('dedicated')) {
      currentUser.achievements.push('dedicated');
      showAchievement('📚 Student Dedicat', 'Finalizeaza 100 de lectii');
    }

    notifyParent('Lectie', `Alex a terminat lectia: ${LESSONS.find(l => l.id === lessonId)?.title || 'Noua lectie'}`);
  }
  closeModal();
  navigate('learning-map');
}


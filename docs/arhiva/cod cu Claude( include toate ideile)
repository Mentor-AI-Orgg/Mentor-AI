        <p class="text-muted">${currentUser.title || ''}</p>
        <div style="margin: 16px 0;">
          <span class="level-badge" style="color: ${rank.color}; border: 1px solid ${rank.color}; font-size: 1rem;">
            ${rank.emoji} ${rank.name} | Nivel ${currentUser.level}
          </span>
        </div>
        <div style="display: flex; justify-content: center; gap: 16px; margin-top: 16px;">

function changeAvatar(avatar) {
  currentUser.avatar = avatar;
  renderProfile(document.getElementById('mainContent'));
}

function changeTitle(title) {
  currentUser.title = title || null;
  renderProfile(document.getElementById('mainContent'));
}

// --- SETTINGS ---
function renderSettings(container) {
  container.innerHTML = `
    <div class="top-bar">
      <div><h1>⚙️ Setari</h1></div>
    </div>
    <div class="grid grid-2">
      <div class="card">
        <div class="card-header"><div class="card-title">🔔 Notificari</div></div>
        ${Object.entries(currentUser.settings.notifications).map(([key, val]) => `
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border);">
            <span>${key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
            <label style="position: relative; display: inline-block; width: 44px; height: 24px;">
              <input type="checkbox" ${val ? 'checked' : ''} onchange="toggleSetting('notifications', '${key}')" style="opacity: 0; width: 0; height: 0;">
              <span style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: ${val ? 'var(--primary)' : 'var(--border)'}; border-radius: 24px; transition: 0.3s;"></span>
            </label>
          </div>
        `).join('')}
      </div>
      <div class="card">
        <div class="card-header"><div class="card-title">🔒 Confidentialitate</div></div>
        <div class="form-group">
          <label>Cine poate trimite cereri de prietenie</label>
          <select class="form-input" onchange="currentUser.settings.privacy.friendRequests = this.value">
            <option value="everyone" ${currentUser.settings.privacy.friendRequests === 'everyone' ? 'selected' : ''}>Toata lumea</option>
            <option value="friends_of_friends" ${currentUser.settings.privacy.friendRequests === 'friends_of_friends' ? 'selected' : ''}>Prieteni de prieteni</option>
          </select>
        </div>
        <div class="form-group">
          <label>Vizibilitate profil</label>
          <select class="form-input" onchange="currentUser.settings.privacy.profileVisibility = this.value">
            <option value="public" ${currentUser.settings.privacy.profileVisibility === 'public' ? 'selected' : ''}>Public</option>
            <option value="friends_only" ${currentUser.settings.privacy.profileVisibility === 'friends_only' ? 'selected' : ''}>Doar prieteni</option>
          </select>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0;">
          <span>Aparitie in leaderboard-uri</span>
          <label style="position: relative; display: inline-block; width: 44px; height: 24px;">
            <input type="checkbox" ${currentUser.settings.privacy.leaderboards ? 'checked' : ''} onchange="currentUser.settings.privacy.leaderboards = this.checked" style="opacity: 0; width: 0; height: 0;">
            <span style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: ${currentUser.settings.privacy.leaderboards ? 'var(--primary)' : 'var(--border)'}; border-radius: 24px; transition: 0.3s;"></span>
          </label>
        </div>
